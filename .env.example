# mcp-secure-db Environment Configuration Template

# Engine Selection: "sqlite" (default, worker-isolated) or "postgres"
MCP_SECURE_DB_ENGINE=sqlite

# Optional declarative policy file path (YAML or JSON) for Bring-Your-Own-DB mode
# MCP_SECURE_DB_POLICY_PATH=./examples/policies/company-sqlite.policy.yaml

# Optional Bearer token for stdio transport mode (validated via RBACManager)
# MCP_SECURE_DB_TOKEN=

# Local demo token opt-in (disabled by default; ALWAYS disabled when NODE_ENV=production)
# Set to "true" ONLY for local development/inspector testing with token-viewer-demo / token-analyst-demo / token-admin-demo
MCP_SECURE_DB_ALLOW_DEMO_TOKENS=false

# Production-safe API keys JSON array (matched via constant-time SHA-256 comparison).
# Each entry accepts either plaintext "token" or pre-hashed 64-hex "tokenSha256", plus "principal", "role" ("public_viewer" | "analyst" | "admin"), and optional "tenantId".
# MCP_SECURE_DB_API_KEYS=[{"tokenSha256":"<64-char-sha256-hex>","principal":"bi-service@corp.internal","role":"analyst","tenantId":"tenant_acme"}]

# OAuth / OIDC single sign-on for the HTTP endpoint (setting the issuer enables it; API keys are then refused on /mcp).
# Copy values from your identity provider's /.well-known/openid-configuration document. See README section 6.1.
# MCP_SECURE_DB_OAUTH_ISSUER=https://your-tenant.okta.com/oauth2/default
# MCP_SECURE_DB_OAUTH_JWKS_URL=https://your-tenant.okta.com/oauth2/default/v1/keys
# MCP_SECURE_DB_OAUTH_AUTHORIZATION_ENDPOINT=https://your-tenant.okta.com/oauth2/default/v1/authorize
# MCP_SECURE_DB_OAUTH_TOKEN_ENDPOINT=https://your-tenant.okta.com/oauth2/default/v1/token
# MCP_SECURE_DB_OAUTH_RESOURCE_URL=https://db-gateway.example.com/mcp
# MCP_SECURE_DB_OAUTH_AUDIENCE=api://mcp-secure-db
# MCP_SECURE_DB_OAUTH_ROLE_CLAIM=groups
# MCP_SECURE_DB_OAUTH_ROLE_MAP={"db-viewers":"public_viewer","db-analysts":"analyst","db-admins":"admin"}
# MCP_SECURE_DB_OAUTH_TENANT_CLAIM=tenant_id
# MCP_SECURE_DB_OAUTH_TRUST_SCOPES=false

# Insecure demo flag (WARNING: DO NOT ENABLE IN PRODUCTION; weakens default-deny to public_viewer when credentials are omitted; ALWAYS disabled when NODE_ENV=production)
MCP_SECURE_DB_INSECURE_DEMO=false

# Optional persistent audit JSONL path override (defaults to ./data/audit.jsonl)
# MCP_SECURE_DB_AUDIT_PATH=./data/audit.jsonl

# Optional keyed HMAC-SHA256 secret for tamper-evident audit chaining (uses unkeyed SHA-256 chain when unset)
# MCP_SECURE_DB_AUDIT_HMAC_KEY=

# Optional dedicated Bearer token for scraping GET /metrics (otherwise requires admin RBAC auth)
# MCP_SECURE_DB_METRICS_TOKEN=

# Set to "true" ONLY inside isolated private networks to allow unauthenticated GET /metrics scrapes
# MCP_SECURE_DB_METRICS_PUBLIC=false

# Structured NDJSON stderr logging ("json" | "off") and minimum level ("info" | "warn" | "error")
# MCP_SECURE_DB_LOG_FORMAT=json
# MCP_SECURE_DB_LOG_LEVEL=info

# PostgreSQL Connection Configuration (used when MCP_SECURE_DB_ENGINE=postgres or in integration tests)
DATABASE_URL=postgres://mcp_gateway:mcp_gateway_test_pw@127.0.0.1:55432/mcp_analytics
PG_TEST_URL=postgres://mcp_gateway:mcp_gateway_test_pw@127.0.0.1:55432/mcp_analytics

# Custom SQLite Database File Path (uncomment after running `pnpm run seed:company` to point server at real_world_company.db; `pnpm run test:gemini` provisions and uses it automatically)
# MCP_SECURE_DB_SQLITE_PATH=./real_world_company.db

# Google Gemini API Key (for real-time agentic interaction via @google/genai)
GEMINI_API_KEY=
