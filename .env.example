# mcp-secure-db Environment Configuration Template

# Engine Selection: "sqlite" (default, worker-isolated) or "postgres"
MCP_SECURE_DB_ENGINE=sqlite

# Insecure demo flag (WARNING: DO NOT ENABLE IN PRODUCTION; weakens default-deny to public_viewer for inspector testing)
MCP_SECURE_DB_INSECURE_DEMO=false

# PostgreSQL Connection Configuration (used when MCP_SECURE_DB_ENGINE=postgres or in integration tests)
DATABASE_URL=postgres://mcp_gateway:mcp_gateway_test_pw@127.0.0.1:55432/mcp_analytics
PG_TEST_URL=postgres://mcp_gateway:mcp_gateway_test_pw@127.0.0.1:55432/mcp_analytics

# Custom SQLite Database File Path (uncomment after running `pnpm run seed:company` to point server at real_world_company.db; `pnpm run test:gemini` provisions and uses it automatically)
# MCP_SECURE_DB_SQLITE_PATH=./real_world_company.db

# Google Gemini API Key (for real-time agentic interaction via @google/genai)
GEMINI_API_KEY=
