{
  "name": "mcp-secure-db",
  "version": "1.0.0",
  "description": "Reference MCP server demonstrating layered SQL query guardrails and worker-isolated SQLite execution",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "mcp-use dev",
    "build": "mcp-use build",
    "start": "mcp-use start",
    "claims:lint": "node --experimental-strip-types scripts/claims-lint.ts",
    "deps:verify": "node --experimental-strip-types scripts/verify-deps.ts",
    "test:unit": "vitest run",
    "test": "vitest run && pnpm run claims:lint && pnpm run deps:verify",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "mcp-use": "2.12.2",
    "node-sql-parser": "5.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
