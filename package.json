{
  "name": "mcp-secure-db",
  "version": "1.0.0",
  "description": "Reference MCP server demonstrating layered SQL query guardrails and worker-isolated SQLite execution",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "mcp-use dev",
    "build": "mcp-use build",
    "start": "mcp-use start",
    "claims:lint": "node --experimental-strip-types scripts/claims-lint.ts",
    "deps:verify": "node --experimental-strip-types scripts/verify-deps.ts",
    "bench": "vitest run tests/benchmark.test.ts",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "pg:up": "docker compose -f docker/docker-compose.postgres.yml up -d --wait",
    "pg:down": "docker compose -f docker/docker-compose.postgres.yml down -v",
    "test": "vitest run && pnpm run claims:lint && pnpm run deps:verify",
    "typecheck": "tsc --noEmit",
    "seed:company": "tsx scripts/seed-company-db.ts",
    "test:gemini": "tsx scripts/gemini-live-tester.ts"
  },
  "dependencies": {
    "@google/genai": "2.32.0",
    "dotenv": "18.0.9",
    "mcp-use": "2.12.2",
    "node-sql-parser": "5.4.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
