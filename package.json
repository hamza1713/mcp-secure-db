{
  "name": "mcp-secure-db",
  "version": "1.0.0",
  "description": "Zero-trust SQL MCP gateway demonstrating declarative policy, live introspection, official PostgreSQL WASM AST validation, parameterized templates, and worker-isolated SQLite execution",
  "type": "module",
  "bin": {
    "mcp-secure-db": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "mcp-use dev",
    "build:cli": "tsc -p tsconfig.build.json",
    "build": "mcp-use build && pnpm run build:cli",
    "start": "mcp-use start",
    "start:stdio": "node dist/cli.js --transport stdio",
    "policy:validate": "node dist/cli.js --validate-policy",
    "audit:verify": "node dist/cli.js --verify-audit",
    "showcase": "tsx scripts/security-showcase.ts",
    "claims:lint": "node --experimental-strip-types scripts/claims-lint.ts",
    "deps:verify": "node --experimental-strip-types scripts/verify-deps.ts",
    "bench": "vitest run tests/benchmark.test.ts",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "pg:up": "docker compose -f docker/docker-compose.postgres.yml up -d --wait",
    "pg:down": "docker compose -f docker/docker-compose.postgres.yml down -v",
    "test": "pnpm run build:cli && vitest run && pnpm run claims:lint && pnpm run deps:verify",
    "typecheck": "tsc --noEmit",
    "seed:company": "tsx scripts/seed-company-db.ts",
    "test:gemini": "tsx scripts/gemini-live-tester.ts"
  },
  "dependencies": {
    "dotenv": "18.0.9",
    "libpg-query": "18.2.4",
    "mcp-use": "2.12.2",
    "node-sql-parser": "5.4.0",
    "pg": "8.23.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@google/genai": "2.32.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
